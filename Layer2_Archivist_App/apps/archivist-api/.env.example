# Reference-only local configuration. Copy to .env; do not commit populated values.
ENVIRONMENT=local
FRONTEND_URL=http://localhost:5173

# Optional feature endpoints. Calls to the corresponding feature fail when absent.
AZURE_FUNCTIONS_BASE_URL=http://localhost:7071
AZURE_FUNCTIONS_CODE=<local-function-host-key>
DATA_INGEST_FUNCTION_URL=http://localhost:7071
DATA_INGEST_FUNCTION_CODE=<local-function-host-key>

# Required for archival data features. Use DefaultAzureCredential/RBAC locally.
COSMOS_DB_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DB_DATABASE_NAME=<database-name>
COSMOS_DB_CONTAINER_NAME=<records-container-name>
COSMOS_DB_AUDIT_CONTAINER_NAME=<audit-container-name>
COSMOS_DB_STATS_CONTAINER_NAME=<statistics-container-name>
COSMOS_DB_BULK_PUBLISH_BATCHES_CONTAINER_NAME=<publish-batches-container-name>
COSMOS_DB_PERIODIC_RUN_HISTORY_CONTAINER_NAME=<run-history-container-name>
COSMOS_DB_CORRECTION_REQUESTS_CONTAINER_NAME=<correction-requests-container-name>
COSMOS_DB_CONNECTION_MODE=Gateway

# Required by storage-backed features. The connection string is local-only.
AZURE_STORAGE_ACCOUNT_NAME=<data-storage-account-name>
ARCHIVIST_STORAGE_ACCOUNT_NAME=<archivist-storage-account-name>
# AZURE_STORAGE_CONNECTION_STRING=<local-azurite-connection-string>

# Required by queue-backed features. Use the connection string only with
# ENVIRONMENT=local; deployed environments require managed identity.
AZURE_SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
# AZURE_SERVICEBUS_CONNECTION_STRING=<local-service-bus-emulator-connection-string>

# Optional AI-assisted OCR.
# AZURE_AI_FOUNDRY_ENDPOINT=https://<ai-account>.cognitiveservices.azure.com/
# AZURE_AI_FOUNDRY_MODEL_NAME=<model-deployment-name>
# AZURE_AI_FOUNDRY_API_VERSION=<api-version>
