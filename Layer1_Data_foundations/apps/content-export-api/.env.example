# Reference-only local configuration. Copy to .env; do not commit populated values.
ENVIRONMENT=local

# Required for protected routes. External callers send the matching X-API-Key.
OUTBOUND_API_KEY=<long-random-local-key>

# Optional audit labels.
OUTBOUND_CALLER_ORG_ID=<caller-organization-id>
OUTBOUND_CALLER_DISPLAY_NAME=<caller-display-name>

# Required data service. Provide endpoint or COSMOS_DB_ACCOUNT_NAME.
COSMOS_DB_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
# Local emulator only; keep empty in cloud environments.
# COSMOS_DB_CONNECTION_STRING=AccountEndpoint=http://127.0.0.1:8081/;AccountKey=<emulator-key>;
COSMOS_DB_DATABASE_NAME=<database-name>
COSMOS_DB_CONTAINER_NAME=<approved-records-container-name>
# COSMOS_DB_ACCOUNT_NAME=<cosmos-account>

# Optional local multi-tenant Azure login hint.
# ENTRA_TENANT_ID=<tenant-id>

# Optional storage hydration.
# AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
# Local emulator only; keep empty in cloud environments.
# AZURE_STORAGE_CONNECTION_STRING=<full-Azurite-connection-string>
# AZURE_STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
# AZURE_STORAGE_CONTAINER_NAME=<storage-container-name>

# Optional telemetry; unset disables export.
# APPLICATIONINSIGHTS_CONNECTION_STRING=<application-insights-connection-string>
APP_INSIGHTS_LOG_LEVEL=INFO

# Portable pagination defaults.
OUTBOUND_LIST_DEFAULT_LIMIT=50
OUTBOUND_LIST_MAX_LIMIT=200
OUTBOUND_MAX_DATE_RANGE_DAYS=90
OUTBOUND_SAS_EXPIRY_HOURS=24
