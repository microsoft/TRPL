# Local frontend configuration.
# Copy to .env.local. Values in angle brackets are placeholders, not secrets.

# Required by the server-side route schema. Local build/tests do not
# contact this URL; chat and artifact APIs require a compatible backend.
PYTHON_RAG_API_URL=http://127.0.0.1:8000
RAG_API_KEY=<local-development-shared-key>

# Optional. Required only to enable image/PDF proxying from one Azure Storage
# account. Must be 3-24 lowercase alphanumeric characters.
# AZURE_STORAGE_ACCOUNT=<storage-account-name>

# Optional. HTTPS origin for externally hosted citation images; omit the path.
# EXTERNAL_IMAGE_ORIGIN=https://<external-image-host>

# Optional public UI values.
NEXT_PUBLIC_APP_NAME=Reading Room
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Production defaults to secure cookies. Set false only for local HTTP.
COOKIE_SECURE=false

# Optional telemetry. Unset means telemetry is disabled.
# NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=<application-insights-connection-string>

# Optional reverse-proxy depth. Use 0 only for local development.
TRUSTED_PROXY_HOPS=0
