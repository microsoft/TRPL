# Reference-only configuration inventory. Replace placeholders only in an ignored local file.
TALK_TO_TR_RUNTIME_MODE=cloud
LIVEKIT_URL=wss://<your-livekit-host>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>
BRAIN_URL=https://<your-agent-api-host>
BRAIN_API_KEY=<your-agent-api-key>
ADMIN_TOKEN=<your-admin-token>
JAILBREAK_VIEW_CODE=<your-view-code>

# Portable process and rate-limit defaults.
TOKEN_SERVER_PORT=8002
TOKEN_RATE_MAX=30
TOKEN_RATE_WINDOW=60
REPORT_RATE_MAX=10
REPORT_RATE_WINDOW=60
