# Reference-only dependency inventory. Copy to .env and replace placeholders locally.
LIA_RUNTIME_MODE=cloud
LLM_API_KEY=<llm-api-key>
LLM_BASE_URL=https://<ai-account>.services.ai.azure.com/openai/v1/
LLM_SMALL_MODEL=<small-model-deployment-name>
LLM_SMALL_INPUT_PRICE_1K=<input-price-per-1k-tokens>
LLM_SMALL_OUTPUT_PRICE_1K=<output-price-per-1k-tokens>
LLM_MID_MODEL=<mid-model-deployment-name>
LLM_MID_INPUT_PRICE_1K=<input-price-per-1k-tokens>
LLM_MID_OUTPUT_PRICE_1K=<output-price-per-1k-tokens>
LLM_LARGE_MODEL=<large-model-deployment-name>
LLM_LARGE_INPUT_PRICE_1K=<input-price-per-1k-tokens>
LLM_LARGE_OUTPUT_PRICE_1K=<output-price-per-1k-tokens>

# Optional text-to-speech.
TTS_ENABLED=False
TTS_AZURE_API_KEY=<speech-api-key>
TTS_AZURE_REGION=<speech-region>
TTS_AZURE_VOICE_ID=<voice-name-or-deployment-id>
TTS_AZURE_DEPLOYMENT_ID=<custom-voice-deployment-id>

# At least one matching client authentication method is required for protected use.
CLIENT_API_KEYS=<comma-separated-client-api-keys>
BASIC_AUTH_USERNAME=<basic-auth-username>
BASIC_AUTH_PASSWORD=<basic-auth-password>

APP_ENV=local
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Optional archive search.
SEARCH_ARCHIVES_QUERY_KEY=<archive-search-query-key>
SEARCH_ARCHIVES_URL=https://<archive-search-service>.search.windows.net
SEARCH_ARCHIVES_INDEX_NAME=<archive-index-name>
SEARCH_ARCHIVES_SEMANTIC_CONFIG=<archive-semantic-config-name>
SEARCH_ARCHIVES_EMBEDDING_MODEL=<embedding-model-deployment-name>
SEARCH_ARCHIVES_EMBEDDING_KEY=<embedding-api-key>
SEARCH_ARCHIVES_EMBEDDING_ENDPOINT=https://<ai-account>.cognitiveservices.azure.com/openai/deployments/<embedding-deployment-name>/embeddings?api-version=<api-version>
SEARCH_ARCHIVES_EMBEDDING_API_VERSION=<api-version>

# Optional book search.
SEARCH_BOOKS_QUERY_KEY=<book-search-query-key>
SEARCH_BOOKS_URL=https://<book-search-service>.search.windows.net
SEARCH_BOOKS_INDEX_NAME=<book-index-name>
SEARCH_BOOKS_SEMANTIC_CONFIG=<book-semantic-config-name>
SEARCH_BOOKS_EMBEDDING_MODEL=<embedding-model-deployment-name>
SEARCH_BOOKS_EMBEDDING_KEY=<embedding-api-key>
SEARCH_BOOKS_EMBEDDING_ENDPOINT=https://<ai-account>.cognitiveservices.azure.com/openai/deployments/<embedding-deployment-name>/embeddings?api-version=<api-version>
SEARCH_BOOKS_EMBEDDING_API_VERSION=<api-version>

# Optional telemetry.
# APPLICATIONINSIGHTS_CONNECTION_STRING=<application-insights-connection-string>

# Required deployment-only guardrails. Keep referenced files outside Git or
# under an ignored private/guardrails/ directory.
LIA_PROMPT_INJECTION_CONFIG_FILE=<path-to-private-prompt-injection-json>
LIA_OUTPUT_REVIEWER_CONFIG_FILE=<path-to-private-output-reviewer-json>
LIA_ROOSEVELT_GUARDRAILS_FILE=<path-to-private-roosevelt-guardrails-text>
LIA_JAILBREAK_CASES_FILE=<path-to-private-regression-cases-json>
LIA_THREAT_PATTERNS_FILE=<path-to-private-threat-patterns-json>
