# Reference-only dependency inventory. Copy to .env and replace placeholders locally.
LIA_AGENT_API_URL=http://localhost:8000
LIA_AGENT_API_KEY=<shared-agent-api-key>
LIA_VISITOR_MODE=<adult-or-child>

LIVEKIT_URL=wss://<livekit-project>.livekit.cloud
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>

AZURE_TTS_API_KEY=<speech-api-key>
AZURE_TTS_REGION=<speech-region>
AZURE_TTS_VOICE=en-US-BrianNeural
AUDIO_DEPLOYMENT=<audio-deployment-name>

# Set false for direct Azure Speech audio with no avatar provider.
AVATAR_ENABLED=True
LEMONSLICE_API_KEY=<avatar-provider-api-key>
LEMONSLICE_AGENT_ID=<avatar-agent-id>
LEMONSLICE_AVATAR_IMAGE_URL=https://<approved-avatar-host>/<approved-avatar-path>
LEMONSLICE_MODEL=<avatar-model-id>

SHOW_PHASE_DEBUG=False
